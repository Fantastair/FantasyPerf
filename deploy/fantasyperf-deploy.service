[Unit]
Description=Publish GitHub CI-verified FantasyPerf main
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
User=fantasyperf-deploy
Group=fantasyperf-deploy
ExecStart=/usr/bin/python3 /usr/local/lib/fantasyperf/publish.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/fantasyperf
TimeoutStartSec=180
