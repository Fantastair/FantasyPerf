[Unit]
Description=Publish verified FantasyPerf main
After=network.target gitea.service nginx.service

[Service]
Type=oneshot
User=fantasyperf-deploy
Group=fantasyperf-deploy
ExecStart=/usr/bin/python3 /usr/local/lib/fantasyperf/publish.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/fantasyperf
TimeoutStartSec=180
