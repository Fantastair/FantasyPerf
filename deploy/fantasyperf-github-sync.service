[Unit]
Description=Sync verified FantasyPerf main to GitHub
After=network.target gitea.service

[Service]
Type=oneshot
User=fantasyperf-deploy
Group=fantasyperf-deploy
ExecStart=/usr/bin/python3 /usr/local/lib/fantasyperf/github_sync.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fantasyperf-sync
TimeoutStartSec=600
