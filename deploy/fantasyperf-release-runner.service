[Unit]
Description=FantasyPerf release trigger runner (host mode)
After=network.target gitea.service

[Service]
User=fantasyperf-release
Group=fantasyperf-release
WorkingDirectory=/var/lib/fantasyperf-release
ExecStart=/usr/local/bin/fantasyperf-runner daemon --config /etc/fantasyperf/release-runner.yaml
Restart=always
RestartSec=5
# 故意不设置 NoNewPrivileges：它会禁止 setuid 提权，而本任务依赖 sudo 调用白名单里的
# systemctl。真正执行发布的仍是被加固的 fantasyperf-deploy.service。
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/fantasyperf-release -/run/sudo -/workspace

[Install]
WantedBy=multi-user.target
