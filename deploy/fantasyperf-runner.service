[Unit]
Description=FantasyPerf repository container runner
After=network.target docker.service gitea.service

[Service]
User=fantasyperf-runner
Group=fantasyperf-runner
WorkingDirectory=/var/lib/fantasyperf-runner
ExecStart=/usr/local/bin/fantasyperf-runner daemon --config /etc/fantasyperf/runner.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
